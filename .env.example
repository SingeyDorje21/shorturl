# Copy this to .env and fill in values as needed.
# All variables have sensible defaults for local development.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL=sqlite+aiosqlite:///./shorturl.db

# Postgres (recommended for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/shorturl

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-32-char-string

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins, or * for all
CORS_ORIGINS=*

# ── URL settings ──────────────────────────────────────────────────────────────
URL_ACTIVE_DAYS_DEFAULT=30
URL_ACTIVE_DAYS_MAX=365

# ── Service URLs (used by gateway) ───────────────────────────────────────────
SHORTENER_BASE_URL=http://localhost:8001
REDIRECT_BASE_URL=http://localhost:8002

# ── Cleanup ───────────────────────────────────────────────────────────────────
CLEANUP_INTERVAL_SECONDS=3600
